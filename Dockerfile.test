# Test image for `make docker-test` / docker-compose.test.yml.
#
# Runs the full local quality gate (fmt, vet, lint, security, tests,
# benchmarks, cross-build) against the Redis service defined in
# docker-compose.test.yml. Tool versions are pinned so that a container build
# today produces the same result as one a month from now.
FROM golang:1.22-bookworm

# Keep these in sync with .github/workflows/ci.yml.
ARG GOLANGCI_LINT_VERSION=v1.59.1
ARG GOSEC_VERSION=v2.20.0
ARG ACTIONLINT_VERSION=v1.7.7

ENV CGO_ENABLED=1 \
    GOFLAGS=-buildvcs=false

# bc is used by the Makefile coverage threshold check; redis-tools lets the
# container verify Redis reachability when debugging a failing run.
# shellcheck backs actionlint's `run:` script analysis; without it those checks
# silently do nothing.
RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        build-essential \
        ca-certificates \
        bc \
        git \
        make \
        redis-tools \
        shellcheck \
    && rm -rf /var/lib/apt/lists/*

RUN go install "github.com/golangci/golangci-lint/cmd/golangci-lint@${GOLANGCI_LINT_VERSION}" \
    && go install "github.com/securego/gosec/v2/cmd/gosec@${GOSEC_VERSION}" \
    && go install "github.com/rhysd/actionlint/cmd/actionlint@${ACTIONLINT_VERSION}"

WORKDIR /app

# Warm the module cache in a separate layer so source edits do not re-download
# dependencies on every build.
COPY go.mod go.sum ./
RUN go mod download

COPY . .

CMD ["make", "ci"]
